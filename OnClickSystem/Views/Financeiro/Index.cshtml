@{
    ViewData["Title"] = "Meu Financeiro";
    
    // Proteção contra valores nulos vindos do Controller
    decimal saldo = ViewBag.Saldo ?? 0m;
    decimal ganhosTotais = ViewBag.GanhosTotais ?? 0m;
    decimal saquesEfetuados = ViewBag.SaquesEfetuados ?? 0m;
    var transacoes = ViewBag.Transacoes as List<OnClickSystem.Domain.Entities.Transacao> ?? new List<OnClickSystem.Domain.Entities.Transacao>();
}

<div class="fade-in-up">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="fw-bold text-gold mb-1"><i class="bi bi-wallet2 me-2 text-gold"></i> Centro Financeiro</h2>
            <p class="text-muted">Controle seus ganhos e gerencie seus saques.</p>
        </div>
        <a href="/Financeiro/SolicitarSaque" class="btn btn-gold px-4 py-2 fw-bold shadow">
            SOLICITAR SAQUE <i class="bi bi-cash-stack ms-1"></i>
        </a>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-12 delay-1">
            <div class="card card-premium p-4 bg-gradient-dark border-gold position-relative overflow-hidden shadow-lg">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <span class="text-muted text-uppercase small fw-bold">Saldo Disponível</span>
                        <h1 class="display-4 fw-bold text-white mb-0">R$ @saldo.ToString("N2")</h1>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <div class="d-inline-block text-start me-4">
                            <small class="text-muted d-block">Ganhos Totais</small>
                            <span class="text-success fw-bold">R$ @ganhosTotais.ToString("N2")</span>
                        </div>
                        <div class="d-inline-block text-start">
                            <small class="text-muted d-block">Saques Efetuados</small>
                            <span class="text-danger fw-bold">R$ @saquesEfetuados.ToString("N2")</span>
                        </div>
                    </div>
                </div>
                @* <i class="bi bi-currency-dollar position-absolute end-0 bottom-0 opacity-10" style="font-size: 3rem; transform: translate(10%, 15%); z-index: 0;"></i> *@
            </div>
        </div>
    </div>

    <div class="card card-premium p-0 delay-2 shadow">
        <div class="card-header bg-dark border-secondary py-3">
            <h5 class="mb-0 text-white"><i class="bi bi-list-check text-gold me-2"></i> Extrato de Movimentações</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0">
                <tbody>
                    @if (transacoes.Any())
                    {
                        foreach (var t in transacoes)
                        {
                            <tr class="align-middle">
                                <td class="ps-4" style="width: 60px;">
                                    <div class="icon-circle @(t.Tipo == "Credito" ? "bg-success" : "bg-danger") bg-opacity-10">
                                        <i class="bi @(t.Tipo == "Credito" ? "bi-arrow-up-right text-success" : "bi-arrow-down-left text-danger")"></i>
                                    </div>
                                </td>
                                <td>
                                    <div class="text-white fw-bold">@t.Descricao</div>
                                    <div class="small text-muted">@t.Data.ToString("dd/MM/yyyy HH:mm")</div>
                                </td>
                                <td class="text-end pe-4 fw-bold fs-5 @(t.Tipo == "Credito" ? "text-success" : "text-danger")">
                                    @(t.Tipo == "Credito" ? "+" : "-") R$ @t.Valor.ToString("N2")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-5 text-muted">Nenhuma movimentação registrada.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .icon-circle {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>