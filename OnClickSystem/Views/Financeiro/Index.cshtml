@using System.Linq
@model List<OnClickSystem.Domain.Entities.Transacao>
@{
    ViewData["Title"] = "Meu Financeiro";
    
    // Recupera os valores enviados pelo Controller
    decimal saldo = ViewBag.Saldo ?? 0m;
    decimal ganhos = ViewBag.GanhosTotais ?? 0m;
    decimal saques = ViewBag.SaquesEfetuados ?? 0m;
}

<div class="fade-in-up container py-4">

    @* 1. ÁREA DE MENSAGENS (Feedback do Saque) *@
    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success bg-success bg-opacity-10 text-success border-success border-opacity-25 fade show shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                <div>@TempData["Sucesso"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger bg-danger bg-opacity-10 text-danger border-danger border-opacity-25 fade show shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                <div>@TempData["Erro"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    @* 2. CABEÇALHO *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-gold mb-1"><i class="bi bi-wallet2 me-2"></i> Centro Financeiro</h2>
            <p class="text-muted small mb-0">Gerencie seu saldo e acompanhe suas movimentações em tempo real.</p>
        </div>
        <a href="/Financeiro/SolicitarSaque" class="btn btn-gold fw-bold px-4 shadow-lg py-2">
            SOLICITAR SAQUE <i class="bi bi-arrow-right-short"></i>
        </a>
    </div>

    @* 3. CARDS DE RESUMO *@
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="card card-premium p-4 bg-black border-gold shadow-lg position-relative overflow-hidden">
                <div class="row align-items-center position-relative" style="z-index: 1;">
                    <div class="col-md-6">
                        <small class="text-muted text-uppercase fw-bold" style="letter-spacing: 1px;">Saldo Disponível</small>
                        <h1 class="display-4 fw-bold text-white mb-0">R$ @saldo.ToString("N2")</h1>
                    </div>
                    <div class="col-md-6 text-md-end mt-3 mt-md-0 border-start border-secondary border-opacity-25 ps-md-5">
                        <div class="d-inline-block text-start me-4">
                            <small class="text-muted d-block text-uppercase" style="font-size: 0.65rem;">Ganhos Totais</small>
                            <span class="text-success fw-bold fs-5">+ R$ @ganhos.ToString("N2")</span>
                        </div>
                        <div class="d-inline-block text-start">
                            <small class="text-muted d-block text-uppercase" style="font-size: 0.65rem;">Saques/Débitos</small>
                            <span class="text-danger fw-bold fs-5">- R$ @saques.ToString("N2")</span>
                        </div>
                    </div>
                </div>
                @* Detalhe visual de fundo *@
                <i class="bi bi-shield-check position-absolute end-0 bottom-0 text-white opacity-5" style="font-size: 8rem; margin-bottom: -2rem; margin-right: -1rem;"></i>
            </div>
        </div>
    </div>

    @* 4. TABELA DE EXTRATO *@
    <div class="card card-premium p-0 shadow border-secondary overflow-hidden">
        <div class="card-header bg-dark py-3 border-bottom border-secondary">
            <h5 class="mb-0 text-white small fw-bold text-uppercase" style="letter-spacing: 1px;">
                <i class="bi bi-clock-history me-2 text-gold"></i> Histórico de Transações
            </h5>
        </div>
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0">
                <thead>
                    <tr class="text-muted small text-uppercase" style="font-size: 0.7rem;">
                        <th class="ps-4">Tipo</th>
                        <th>Detalhes</th>
                        <th class="text-end pe-4">Valor</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var t in Model)
                        {
                            <tr class="align-middle">
                                <td class="ps-4" style="width: 60px;">
                                    <div class="icon-box @(t.Tipo == "Credito" ? "text-success" : "text-danger")">
                                        <i class="bi @(t.Tipo == "Credito" ? "bi-arrow-up-circle-fill" : "bi-arrow-down-circle-fill") fs-4"></i>
                                    </div>
                                </td>
                                <td>
                                    <div class="text-white fw-bold small">@t.Descricao</div>
                                    <div class="text-muted" style="font-size: 0.7rem;">@t.Data.ToString("dd/MM/yyyy HH:mm")</div>
                                </td>
                                <td class="text-end pe-4 fw-bold @(t.Tipo == "Credito" ? "text-success" : "text-danger")">
                                    @(t.Tipo == "Credito" ? "+" : "-") R$ @t.Valor.ToString("N2")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-5 text-muted small italic">
                                <i class="bi bi-info-circle me-2"></i> Nenhuma movimentação registrada até o momento.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    /* Estilo para os ícones da tabela */
    .icon-box {
        opacity: 0.8;
        transition: 0.3s;
    }
    tr:hover .icon-box {
        opacity: 1;
        transform: scale(1.1);
    }
</style>