@model OnClickSystem.Application.DTOs.SolicitacaoSaqueDTO
@{
    ViewData["Title"] = "Solicitar Saque";
    // Pegamos o saldo que o Controller enviou
    decimal saldoDisponivel = ViewBag.SaldoDisponivel ?? 0m;
}

<div class="container py-5 fade-in-up">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            
            <div class="card card-premium bg-black border-gold shadow-lg p-4">
                <div class="text-center mb-4">
                    <div class="bg-gold bg-opacity-10 d-inline-block p-3 rounded-circle mb-2">
                        <i class="bi bi-cash-coin text-gold fs-1"></i>
                    </div>
                    <h3 class="text-white fw-bold mb-0">Solicitar Saque</h3>
                    <p class="text-muted small">O valor será transferido para sua chave PIX.</p>
                </div>

                <div class="bg-dark p-3 rounded-3 mb-4 text-center border border-secondary border-opacity-25">
                    <span class="text-muted small text-uppercase fw-bold d-block">Seu Saldo Disponível</span>
                    <h2 class="text-gold fw-bold mb-0">R$ @saldoDisponivel.ToString("N2")</h2>
                </div>

                @* IMPORTANTE: asp-action deve ser ConfirmarSaque *@
                <form asp-controller="Financeiro" asp-action="ConfirmarSaque" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold text-uppercase">Quanto deseja sacar?</label>
                        <div class="input-group">
                            <span class="input-group-text bg-black border-secondary text-gold">R$</span>
                            @* O nome 'Valor' deve bater com o DTO *@
                            <input asp-for="Valor" type="number" step="0.01" class="form-control bg-dark border-secondary text-white fs-4 py-2" placeholder="0,00" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold text-uppercase">Tipo de Chave</label>
                        @* O nome 'TipoChave' deve bater com o DTO *@
                        <select asp-for="TipoChave" class="form-select bg-dark border-secondary text-white">
                            <option value="CPF">CPF</option>
                            <option value="Email">E-mail</option>
                            <option value="Telefone">Celular</option>
                            <option value="Aleatoria">Chave Aleatória</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted small fw-bold text-uppercase">Sua Chave PIX</label>
                        @* O nome 'ChavePix' deve bater com o DTO *@
                        <input asp-for="ChavePix" type="text" class="form-control bg-dark border-secondary text-white" placeholder="Insira sua chave aqui..." required />
                    </div>

                    <button type="submit" class="btn btn-gold w-100 fw-bold py-3 shadow">
                        CONFIRMAR E SOLICITAR <i class="bi bi-check2-circle ms-1"></i>
                    </button>
                    
                    <a asp-action="Index" class="btn btn-link text-muted w-100 mt-3 text-decoration-none small">
                        Cancelar e Voltar
                    </a>
                </form>
            </div>

        </div>
    </div>
</div>