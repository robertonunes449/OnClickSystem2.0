@{
    Layout = null;
    ViewData["Title"] = "Acesso Premium";
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - OnClick Elite</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <link rel="stylesheet" href="~/css/premium.css" />
</head>
<body class="body-login">

    <div class="card-premium card-login p-4 fade-in-up">
        <div class="text-center mb-4">
            <div class="icon-box-login">
                <i class="bi bi-gem"></i>
            </div>
            <h3 class="text-gold fw-bold">OnClick System</h3>
            <p class="text-muted small">Área Exclusiva para Associados</p>
        </div>

        @if (ViewBag.Erro != null)
        {
            <div class="alert alert-danger bg-dark border-danger text-danger text-center py-2">
                <small><i class="bi bi-x-circle"></i> @ViewBag.Erro</small>
            </div>
        }

        <form action="/Login/Entrar" method="post">
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            <div class="mb-3">
                <label class="form-label text-secondary small">LOGIN</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-gold"><i class="bi bi-person-fill"></i></span>
                    <input type="email" name="email" class="form-control form-control-premium" placeholder="Seu e-mail" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label text-secondary small">SENHA</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-gold"><i class="bi bi-lock-fill"></i></span>
                    <input type="password" id="senhaInput" name="senha" class="form-control form-control-premium" placeholder="••••••" required />
                    <button class="btn btn-outline-secondary bg-dark border-secondary text-gold" type="button" id="btnToggleSenha">
                        <i class="bi bi-eye" id="iconeSenha"></i>
                    </button>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input bg-dark border-secondary" id="lembrar" name="lembrar" value="true">
                    <label class="form-check-label text-secondary small" for="lembrar">Lembrar-me</label>
                </div>
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-gold py-2">Acessar Painel</button>
            </div>
        </form>

        <div class="text-center mt-4">
            <a href="#" class="text-muted small text-decoration-none">Esqueci minha senha</a>
        </div>
    </div>


    <script>
            document.addEventListener("DOMContentLoaded", function() {
                const btnToggle = document.getElementById('btnToggleSenha');
                const senhaInput = document.getElementById('senhaInput');
                const iconeSenha = document.getElementById('iconeSenha');

                btnToggle.addEventListener('click', function () {
                    if (senhaInput.type === 'password') {
                        senhaInput.type = 'text';
                        iconeSenha.classList.replace('bi-eye', 'bi-eye-slash');
                    } else {
                        senhaInput.type = 'password';
                        iconeSenha.classList.replace('bi-eye-slash', 'bi-eye');
                    }
                });
            });
    </script>


</body>
</html>