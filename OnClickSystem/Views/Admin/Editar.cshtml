@model OnClickSystem.Domain.Entities.Usuario
@{
    ViewData["Title"] = $"Ajustar Perfil - {Model.Nome}";
}

<div class="container py-4 fade-in-up">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <a asp-action="Usuarios" class="btn btn-link text-muted p-0 mb-4 text-decoration-none">
                <i class="bi bi-arrow-left"></i> Voltar para a Lista
            </a>

            <div class="card card-premium shadow-lg border-gold overflow-hidden">
                <div class="card-header bg-black py-4 border-secondary border-opacity-25">
                    <h4 class="mb-0 text-gold fw-bold text-center">
                        <i class="bi bi-shield-lock me-2"></i> AJUSTAR PERFIL
                    </h4>
                </div>

                <div class="card-body bg-dark p-4 p-md-5">
                    <form asp-action="Editar" method="post">
                        <input type="hidden" asp-for="ID" />

                        <div class="row g-4 mb-5">
                            <div class="col-12 text-center">
                                <p class="text-muted small text-uppercase fw-bold border-bottom border-secondary border-opacity-25 pb-2">Informações de Acesso</p>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-white-50 small fw-bold text-uppercase">Nome Completo</label>
                                <input asp-for="Nome" class="form-control-premium" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-white-50 small fw-bold text-uppercase">E-mail de Login</label>
                                <input asp-for="Email" type="email" class="form-control-premium" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-white-50 small fw-bold text-uppercase">Cargo (Hierarquia)</label>
                                <select asp-for="Perfil" class="form-select select-premium text-white">
                                    <option value="Comum">Afiliado</option>
                                    <option value="Cliente">Cliente</option>
                                    <option value="Admin">Administrador</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-white-50 small fw-bold text-uppercase">Nova Senha</label>
                                <input type="password" name="NovaSenha" class="form-control-premium" placeholder="Manter atual" />
                            </div>
                        </div>

                        <div class="row g-4 p-4 rounded-3 bg-black bg-opacity-20 border border-secondary border-opacity-10 mb-5">
                            <div class="col-12 text-center">
                                <p class="text-gold small text-uppercase fw-bold mb-2"><i class="bi bi-wallet2 me-2"></i>Dados Financeiros</p>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label text-white-50 small fw-bold text-uppercase">Tipo de Chave PIX</label>
                                <select asp-for="TipoChavePix" class="form-select select-premium text-white">
                                    <option value="CPF">CPF</option>
                                    <option value="Email">E-mail</option>
                                    <option value="Celular">Celular / Telefone</option>
                                    <option value="Aleatoria">Chave Aleatória</option>
                                </select>
                            </div>
                            <div class="col-md-7">
                                <label class="form-label text-white-50 small fw-bold text-uppercase">Chave PIX</label>
                                <input asp-for="ChavePix" class="form-control-premium" placeholder="Digite a chave..." />
                            </div>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-gold btn-lg fw-bold shadow-lg py-3">
                                <i class="bi bi-check-circle-fill me-2"></i> SALVAR ALTERAÇÕES
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Estilo de Input Minimalista: Apenas borda inferior */
    .form-control-premium {
        background: transparent;
        border: 0;
        border-bottom: 2px solid #3c3c3c;
        border-radius: 0;
        color: #fff;
        width: 100%;
        padding: 10px 0;
        transition: 0.3s;
    }
    .form-control-premium:focus {
        background: transparent;
        border-bottom-color: #d4af37;
        box-shadow: none;
        outline: 0;
    }
    .select-premium {
        background: transparent;
        border: 0;
        border-bottom: 2px solid #3c3c3c;
        border-radius: 0;
        padding: 10px 0;
    }
    .select-premium:focus {
        border-bottom-color: #d4af37;
        box-shadow: none;
        background: #1a1a1a;
    }
</style>