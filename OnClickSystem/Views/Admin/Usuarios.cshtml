@model IEnumerable<OnClickSystem.Domain.Entities.Usuario>
@{
    ViewData["Title"] = "Gestão de Usuários";
}

@* 1. Wrapper principal com animação de entrada *@
<div class="fade-in-up">
    <div class="mb-4">
        <h2 class="fw-bold text-gold"><i class="bi bi-people-fill me-2"></i> Gestão de Associados</h2>
        <p class="text-muted">Administre as permissões, perfis e o status de acesso de todos os usuários.</p>
    </div>

    @* 2. Barra de Busca com delay-1 *@
    <div class="card card-premium p-3 mb-4 delay-1 shadow-sm border-secondary">
        <form asp-action="Usuarios" method="get" class="row g-2 align-items-center">
            <div class="col-md-10">
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="busca" class="form-control bg-dark border-secondary text-white"
                           placeholder="Buscar por nome ou e-mail..." value="@ViewData["BuscaAtual"]">
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-gold w-100 fw-bold">PESQUISAR</button>
            </div>
        </form>
    </div>

    @* 3. Tabela de Usuários com delay-2 *@
    <div class="card card-premium p-0 overflow-hidden shadow-lg delay-2">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle">
                <thead class="bg-black text-muted small text-uppercase">
                    <tr>
                        <th class="ps-4 py-3">Usuário</th>
                        <th>Perfil</th>
                        <th class="text-center">Status</th>
                        <th class="text-center">Data Cadastro</th>
                        <th class="text-end pe-4">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="bg-gold bg-opacity-10 p-2 rounded-circle me-3 text-gold">
                                        <i class="bi bi-person-badge fs-5"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-white">@user.Nome</div>
                                        <div class="text-muted small">@user.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge @(user.Perfil == "Admin" ? "bg-danger" : "bg-primary") bg-opacity-10 text-uppercase" style="font-size: 0.65rem;">
                                    @user.Perfil
                                </span>
                            </td>
                            <td class="text-center">
                                @if (user.Ativo)
                                {
                                    <span class="text-success small fw-bold"><i class="bi bi-patch-check-fill me-1"></i> ATIVO</span>
                                }
                                else
                                {
                                    <span class="text-danger small fw-bold"><i class="bi bi-x-octagon-fill me-1"></i> INATIVO</span>
                                }
                            </td>
                            <td class="text-center text-muted small">
                                @user.DataCadastro.ToString("dd/MM/yyyy")
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group">
                                    <a asp-action="Detalhes" asp-route-id="@user.ID" class="btn btn-outline-gold btn-sm">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Editar" asp-route-id="@user.ID" class="btn btn-outline-gold btn-sm mx-1">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="AlternarStatus" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@user.ID" />
                                        <button type="submit" class="btn @(user.Ativo ? "btn-outline-danger" : "btn-outline-success") btn-sm">
                                            <i class="bi @(user.Ativo ? "bi-lock" : "bi-unlock")"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    /* Hover suave na linha para manter o padrão premium */
    .table-hover tbody tr:hover {
        background-color: rgba(212, 175, 55, 0.03) !important;
        transition: 0.3s;
    }

    .btn-outline-gold {
        border-color: rgba(212, 175, 55, 0.5);
        color: #d4af37;
    }

        .btn-outline-gold:hover {
            background-color: #d4af37;
            color: #000;
        }
</style>