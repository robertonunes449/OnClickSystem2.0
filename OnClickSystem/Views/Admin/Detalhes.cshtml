@model OnClickSystem.Domain.Entities.Usuario
@{
    ViewData["Title"] = $"Perfil de {Model.Nome}";
}

<div class="container py-4 fade-in-up">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-controller="Admin" asp-action="Usuarios" class="btn btn-link text-muted p-0 text-decoration-none">
            <i class="bi bi-arrow-left"></i> Voltar para a Lista
        </a>
    </div>

    <div class="card card-premium shadow-lg border-gold overflow-hidden">
        @* Cabeçalho sem foto - Foco em Tipografia *@
        <div class="card-header bg-black text-center py-5 border-secondary border-opacity-25">
            <h2 class="text-white fw-bold mb-1" style="letter-spacing: -1px;">@Model.Nome</h2>
            <p class="text-gold small fw-bold mb-3 text-uppercase" style="letter-spacing: 2px;">@Model.Perfil</p>
            <span class="badgePremium @(Model.Ativo ? "badgePremium-success" : "badgePremium-warning")">
                @(Model.Ativo ? "CONTA ATIVA" : "AGUARDANDO ATIVAÇÃO")
            </span>
        </div>
        
        <div class="card-body p-4 p-md-5">
            <div class="row g-4">
                <div class="col-lg-6">
                    <h6 class="text-gold fw-bold text-uppercase small mb-4">Dados do Associado</h6>
                    <div class="row g-4">
                        <div class="col-6">
                            <label class="text-uppercase text-muted small fw-bold d-block mb-1">E-mail</label>
                            <span class="text-white">@Model.Email</span>
                        </div>
                        <div class="col-6">
                            <label class="text-uppercase text-muted small fw-bold d-block mb-1">Desde</label>
                            <span class="text-white">@Model.DataCadastro.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="col-12">
                            <label class="text-uppercase text-muted small fw-bold d-block mb-1">Chave PIX (@Model.TipoChavePix)</label>
                            <span class="text-gold font-monospace">@(string.IsNullOrEmpty(Model.ChavePix) ? "Não informada" : Model.ChavePix)</span>
                        </div>
                        <div class="col-12">
                            <label class="text-uppercase text-muted small fw-bold d-block mb-1">Patrocinador</label>
                            <span class="text-white-50 small">@(Model.Patrocinador?.Nome ?? "Direto (sem indicação)")</span>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6 bg-black bg-opacity-25 p-4 rounded-3 border border-secondary border-opacity-10 shadow-inner">
                    <h6 class="text-white-50 fw-bold text-uppercase small mb-4 text-center">Painel de Controle</h6>
                    <div class="row g-3">
                        <div class="col-12">
                            <form asp-action="AlterarPerfilDetalhes" method="post" class="d-flex gap-2">
                                <input type="hidden" name="id" value="@Model.ID" />
                                <select name="novoPerfil" class="form-select bg-dark text-white border-secondary select-premium">
                                    <!option value="Comum" @(Model.Perfil == "Comum" ? "selected" : "")>Afiliado</!option>
                                    <!option value="Cliente" @(Model.Perfil == "Cliente" ? "selected" : "")>Cliente</!option>
                                    <!option value="Admin" @(Model.Perfil == "Admin" ? "selected" : "")>Administrador</!option>
                                </select>
                                <button type="submit" class="btn btn-gold fw-bold px-4">ALTERAR</button>
                            </form>
                        </div>
                        
                        <div class="col-6">
                            <form asp-action="AlternarStatus" method="post">
                                <input type="hidden" name="id" value="@Model.ID" />
                                <button type="submit" class="btn @(Model.Ativo ? "btn-outline-danger" : "btn-gold") w-100 fw-bold py-2">
                                    @(Model.Ativo ? "BLOQUEAR" : "ATIVAR")
                                </button>
                            </form>
                        </div>

                        <div class="col-6">
                            <form asp-action="Deletar" method="post" onsubmit="return confirm('Excluir permanentemente?')">
                                <input type="hidden" name="id" value="@Model.ID" />
                                <button type="submit" class="btn btn-premium-danger w-100 fw-bold py-2">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Estilos Premium locais para o Detalhes */
    .border-gold { border: 1px solid #d4af37 !important; border-top: 4px solid #d4af37 !important; }
    
    /* Badges com brilho tecnológico */
    .badgePremium { padding: 5px 15px; border-radius: 50px; font-size: 0.7rem; font-weight: bold; border: 1px solid; }
    .badgePremium-success { background: rgba(25, 135, 84, 0.1); color: #198754; border-color: #198754; box-shadow: 0 0 10px rgba(25, 135, 84, 0.2); }
    .badgePremium-warning { background: rgba(212, 175, 55, 0.1); color: #d4af37; border-color: #d4af37; box-shadow: 0 0 10px rgba(212, 175, 55, 0.2); }

    /* Inputs e Selects Sombreados */
    .select-premium { border-bottom: 2px solid #d4af37; padding-left: 10px; border-radius: 0; }
    
    /* Botões com elevação tecnológica */
    .btn-w-100 { padding-top: 10px; padding-bottom: 10px; }
    .btn-premium-danger { background-color: transparent; color: #dc3545; border: 2px solid #dc3545; transition: 0.3s; }
    .btn-premium-danger:hover { background-color: #dc3545; color: white; box-shadow: 0 0 15px rgba(220, 53, 69, 0.5); }
</style>