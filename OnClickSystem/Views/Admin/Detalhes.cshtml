@model OnClickSystem.Domain.Entities.Usuario
@{
    ViewData["Title"] = "Gerenciar Membro";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-gold fw-bold"><i class="bi bi-person-vcard me-2"></i> Perfil do Membro</h3>
        <a asp-controller="Rede" asp-action="Index" class="btn btn-outline-secondary btn-sm">Voltar para Rede</a>
    </div>

    <div class="card bg-dark border-secondary shadow mb-4">
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-md-2 text-center">
                    <div class="rounded-circle bg-secondary d-flex justify-content-center align-items-center mx-auto" style="width: 80px; height: 80px;">
                        <i class="bi bi-person text-white fs-1"></i>
                    </div>
                </div>
                <div class="col-md-10">
                    <h2 class="text-white mb-1">@Model.Nome</h2>
                    <p class="text-muted mb-2">@Model.Email</p>
                    <div class="d-flex gap-3 small">
                        <span class="text-gold"><i class="bi bi-calendar-check me-1"></i> Cadastro: @Model.DataCadastro.ToString("dd/MM/yyyy")</span>
                        <span class="text-secondary"><i class="bi bi-person-up me-1"></i> Patrocinador: @(Model.Patrocinador?.Nome ?? "Direto da Empresa")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card bg-black border-secondary h-100 p-3">
                <h6 class="text-gold fw-bold mb-3 small">ALTERAR CARGO</h6>
                <form asp-action="AlterarPerfilDetalhes" method="post">
                    <input type="hidden" name="id" value="@Model.ID" />
                    <select name="novoPerfil" class="form-select bg-dark text-white border-secondary mb-3">
                        <!option value="Admin" @(Model.Perfil == "Admin" ? "selected" : "")>Administrador</!option>
                        <!option value="Comum" @(Model.Perfil == "Comum" ? "selected" : "")>Afiliado</!option>
                        <!option value="Cliente" @(Model.Perfil == "Cliente" ? "selected" : "")>Cliente</!option>
                    </select>
                    <button type="submit" class="btn btn-gold w-100 fw-bold">SALVAR CARGO</button>
                </form>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-black border-secondary h-100 p-3 text-center">
                <h6 class="text-gold fw-bold mb-3 small text-start text-uppercase">Status da Conta</h6>
                <div class="my-auto">
                    @if (Model.Ativo)
                    {
                        <span class="badge bg-success px-4 py-2 mb-3">CONTA ATIVA</span>
                    }
                    else
                    {
                        <span class="badge bg-danger px-4 py-2 mb-3">PENDENTE</span>
                    }
                    <form asp-action="AlternarStatus" method="post">
                        <input type="hidden" name="id" value="@Model.ID" />
                        <button type="submit" class="btn @(Model.Ativo ? "btn-outline-danger" : "btn-success") w-100 fw-bold">
                            @(Model.Ativo ? "DESATIVAR" : "ATIVAR AGORA")
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-black border-danger h-100 p-3">
                <h6 class="text-danger fw-bold mb-3 small">ZONA CRÍTICA</h6>
                <p class="text-muted small">Cuidado! A exclusão é permanente e removerá todos os dados do usuário.</p>
                <form asp-action="Deletar" method="post" onsubmit="return confirm('Tem certeza absoluta que deseja excluir este membro?')">
                    <input type="hidden" name="id" value="@Model.ID" />
                    <button type="submit" class="btn btn-danger w-100 fw-bold">
                        <i class="bi bi-trash me-2"></i>EXCLUIR DEFINITIVAMENTE
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>