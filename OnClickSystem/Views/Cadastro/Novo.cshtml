@model OnClickSystem.Domain.Entities.Usuario
@{
    // Alterado de "_LayoutLogin" para "_Layout" (que já existe no seu projeto)
    Layout = "_Layout";
    ViewData["Title"] = "Nova Conta Premium";
}

<div class="container py-5 fade-in-up">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card card-premium p-4 p-md-5 shadow-lg border-gold">
                <div class="text-center mb-5">
                    <div class="mb-3">
                        <i class="bi bi-person-plus text-gold" style="font-size: 3.5rem;"></i>
                    </div>
                    <h2 class="fw-bold text-white">Criar Conta</h2>
                    <p class="text-muted">Junte-se à elite da OnClick System.</p>
                </div>

                @if (ViewBag.PatrocinadorNome != null)
                {
                    <div class="alert alert-dark border-warning d-flex align-items-center mb-4">
                        <i class="bi bi-star-fill text-gold fs-4 me-3"></i>
                        <div>
                            <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.6rem;">Patrocinador(a)</small>
                            <span class="text-white fw-bold">@ViewBag.PatrocinadorNome</span>
                        </div>
                    </div>
                }

                <form asp-action="Registrar" method="post">

                    <div class="mb-4">
                        <label class="form-label text-gold small fw-bold">POSSUI LINK DE INDICAÇÃO? (OPCIONAL)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-gold"><i class="bi bi-link-45deg"></i></span>
                            <input type="text" id="inputPatrocinador" name="indicadoPor"
                                   class="form-control bg-dark border-secondary text-white"
                                   placeholder="Cole o link aqui ou digite o nome"
                                   value="@ViewBag.PatrocinadorSugerido" />
                        </div>
                        <small class="text-muted">O sistema identificará seu patrocinador automaticamente.</small>
                    </div>


                    <input type="hidden" name="ID_Patrocinador" value="@ViewBag.PatrocinadorID" />
                    
                    <div class="mb-3">
                        <label class="form-label text-muted small">NOME COMPLETO</label>
                        <input asp-for="Nome" class="form-control form-control-premium" placeholder="Ex: fulano de tal" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small">E-MAIL</label>
                        <input asp-for="Email" type="email" class="form-control form-control-premium" placeholder="seu@email.com" required />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">SENHA</label>
                            <input asp-for="Senha" type="password" class="form-control form-control-premium" placeholder="••••••" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">CONFIRMAR</label>
                            <input type="password" id="confirmaSenha" class="form-control form-control-premium" placeholder="••••••" required />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-gold btn-lg w-100 fw-bold mt-4 shadow">
                        FINALIZAR CADASTRO <i class="bi bi-check-lg ms-2"></i>
                    </button>
                    
                    <div class="text-center mt-4">
                        <a asp-controller="Login" asp-action="Index" class="text-muted small text-decoration-none">
                            Já possui uma conta? <span class="text-gold fw-bold">Acesse aqui</span>
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
            document.getElementById('inputPatrocinador').addEventListener('input', function(e) {
                let value = e.target.value;
                // Se o cara colou o link completo (ex: http://.../?patrocinador=Arthur)
                if (value.includes('patrocinador=')) {
                    let nome = value.split('patrocinador=')[1];
                    e.target.value = nome; // Limpa e deixa só o nome no campo
                }
            });
    </script>



</div>