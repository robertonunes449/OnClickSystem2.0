@model IEnumerable<OnClickSystem.Domain.Entities.CarrinhoItem>
@{
    ViewData["Title"] = "Finalizar Pedido";
}

<div class="container py-5 fade-in-up">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-gold"><i class="bi bi-shield-lock-fill me-2"></i> Checkout Seguro</h2>
        <p class="text-muted">Revise seus itens e escolha a forma de ativação.</p>
    </div>

    <div class="row g-4">
        <div class="col-lg-5 delay-1">
            <div class="card card-premium h-100 shadow">
                <div class="card-header bg-dark border-secondary py-3">
                    <h5 class="mb-0 text-white">Resumo da Estratégia</h5>
                </div>
                <div class="card-body">
                    @foreach (var item in Model)
                    {
                        <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary border-opacity-25 pb-3">
                            <div class="d-flex align-items-center">
                                <div class="icon-box-small me-3">
                                    <i class="bi bi-box-seam text-gold"></i>
                                </div>
                                <div>
                                    <h6 class="text-white mb-0">@item.Nome</h6>
                                    <small class="text-muted">Ativação Imediata</small>
                                </div>
                            </div>
                            <span class="fw-bold text-white">R$ @item.Preco.ToString("N2")</span>
                        </div>
                    }

                    <div class="mt-4 p-3 bg-dark bg-opacity-50 rounded-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Subtotal</span>
                            <span class="text-white">R$ @Model.Sum(x => x.Preco).ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="fw-bold text-white fs-5">Total a Pagar</span>
                            <span class="fw-bold text-gold fs-4">R$ @Model.Sum(x => x.Preco).ToString("N2")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-7 delay-2">
            <div class="card card-premium h-100 shadow border-gold">
                <div class="card-body p-4 p-md-5">
                    <h4 class="text-white mb-4">Confirmar Ativação</h4>
                    
                    <form asp-action="ProcessarCheckout" method="post">
                        <div class="mb-4">
                            <label class="form-label text-muted small fw-bold">FORMA DE PAGAMENTO</label>
                            <div class="row g-2">
                                <div class="col-4">
                                    <input type="radio" class="btn-check" name="formaPagamento" id="payPix" value="Pix" checked onclick="togglePayment('pix')">
                                    <label class="btn btn-outline-gold w-100 py-3" for="payPix">
                                        <i class="bi bi-qr-code-scan d-block fs-4 mb-1"></i> PIX
                                    </label>
                                </div>
                                <div class="col-4">
                                    <input type="radio" class="btn-check" name="formaPagamento" id="payCard" value="Cartao" onclick="togglePayment('card')">
                                    <label class="btn btn-outline-gold w-100 py-3" for="payCard">
                                        <i class="bi bi-credit-card d-block fs-4 mb-1"></i> CARTÃO
                                    </label>
                                </div>
                                <div class="col-4">
                                    <input type="radio" class="btn-check" name="formaPagamento" id="payBoleto" value="Boleto" onclick="togglePayment('boleto')">
                                    <label class="btn btn-outline-gold w-100 py-3" for="payBoleto">
                                        <i class="bi bi-barcode d-block fs-4 mb-1"></i> BOLETO
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div id="areaPix" class="text-center p-3 bg-dark rounded-3 mb-4 border border-secondary animate__animated animate__fadeIn">
                            <p class="text-white-50 small mb-2">Escaneie o código para pagar</p>
                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=OnClickSystemPayment" alt="QR Code" class="img-fluid rounded border border-white p-1 mb-2">
                            <p class="text-gold mb-0 small font-monospace">onclick-pix-chave-aleatoria-123</p>
                        </div>

                        <div id="areaCard" class="d-none animate__animated animate__fadeIn">
                            <div class="card card-premium p-3 border-secondary mb-4 bg-dark">
                                <input type="text" class="form-control bg-transparent border-0 border-bottom border-secondary text-white mb-3" placeholder="Nome no Cartão">
                                <input type="text" class="form-control bg-transparent border-0 border-bottom border-secondary text-white mb-3" placeholder="0000 0000 0000 0000">
                                <div class="row">
                                    <div class="col-6"><input type="text" class="form-control bg-transparent border-0 border-bottom border-secondary text-white" placeholder="MM/AA"></div>
                                    <div class="col-6"><input type="text" class="form-control bg-transparent border-0 border-bottom border-secondary text-white" placeholder="CVV"></div>
                                </div>
                            </div>
                        </div>

                        <div id="areaBoleto" class="d-none animate__animated animate__fadeIn">
                            <div class="card bg-white text-dark p-4 rounded-3 shadow-sm mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="fw-bold mb-0"><i class="bi bi-bank me-2"></i> BOLETO BANCÁRIO</h6>
                                    <span class="badge bg-dark text-white">Vence em 3 dias</span>
                                </div>
        
                                <div class="p-3 bg-light rounded-2 border border-dashed border-secondary mb-3">
                                    <small class="text-muted d-block mb-2 text-uppercase fw-bold" style="font-size: 0.6rem;">Linha Digitável</small>
                                    <input type="text" id="codigoBoleto" class="form-control-plaintext fw-bold text-center fs-5 p-0"
                                           value="00190.00009 02314.500004 00000.000001 1 95430000015000" readonly>
                                </div>

                                <button type="button" class="btn btn-dark w-100 fw-bold" onclick="copiarBoleto(this)">
                                    <i class="bi bi-clipboard-check me-2"></i> COPIAR CÓDIGO DE BARRAS
                                </button>
        
                                <div class="mt-3 text-center">
                                    <small class="text-muted" style="font-size: 0.7rem;">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Após o pagamento, a compensação pode levar até 48h úteis.
                                    </small>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid gap-3 mt-4">
                            <button type="submit" class="btn btn-gold btn-lg py-3 fw-bold shadow">
                                FINALIZAR E ATIVAR AGORA <i class="bi bi-lightning-charge-fill ms-2"></i>
                            </button>
                        </div>
                    </form>

                    <script>
                                            function togglePayment(type) {
                                                // Esconde todas as áreas primeiro
                                                document.getElementById('areaPix').classList.add('d-none');
                                                document.getElementById('areaCard').classList.add('d-none');
                                                document.getElementById('areaBoleto').classList.add('d-none');

                                                // Mostra apenas a selecionada
                                                if (type === 'pix') {
                                                    document.getElementById('areaPix').classList.remove('d-none');
                                                } else if (type === 'card') {
                                                    document.getElementById('areaCard').classList.remove('d-none');
                                                } else if (type === 'boleto') {
                                                    document.getElementById('areaBoleto').classList.remove('d-none');
                                                }
                                            }


                                                                                        function copiarBoleto(btn) {
                                                var copyText = document.getElementById("codigoBoleto");
                                                copyText.select();
                                                copyText.setSelectionRange(0, 99999); // Para mobile
    
                                                navigator.clipboard.writeText(copyText.value).then(() => {
                                                    // Feedback visual no botão do boleto
                                                    const originalHtml = btn.innerHTML;
                                                    btn.innerHTML = '<i class="bi bi-check-lg"></i> CÓDIGO COPIADO!';
                                                    btn.classList.replace('btn-dark', 'btn-success');
        
                                                    setTimeout(() => {
                                                        btn.innerHTML = originalHtml;
                                                        btn.classList.replace('btn-success', 'btn-dark');
                                                    }, 2500);
                                                });
                                            }
                    </script>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .icon-box-small {
        width: 40px;
        height: 40px;
        background: rgba(212, 175, 55, 0.1);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .payment-option {
        border: 2px solid #d4af37;
        background: rgba(212, 175, 55, 0.05);
        border-radius: 12px;
        padding: 20px;
        text-align: center;
        color: white;
        display: flex;
        flex-direction: column;
        align-items: center;
        cursor: pointer;
    }

        .payment-option i {
            color: #d4af37;
        }
</style>