@model IEnumerable<OnClickSystem.Domain.Entities.CarrinhoItem>
@{
    ViewData["Title"] = "Meu Carrinho";
}

<div class="container py-4 fade-in-up">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-gold mb-0"><i class="bi bi-cart3 me-2"></i> Carrinho de Compras</h2>
        <a href="/Loja/Index" class="btn btn-outline-secondary btn-sm rounded-pill">
            <i class="bi bi-arrow-left"></i> Continuar Comprando
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            <div class="col-lg-8 delay-1">
                <div class="card card-premium p-0 overflow-hidden">
                    <div class="table-responsive">
                        <table class="table table-dark table-hover mb-0 align-middle">
                            <thead class="text-muted small text-uppercase bg-black">
                                <tr>
                                    <th class="ps-4">Item</th>
                                    <th class="text-center">Preço</th>
                                    <th class="text-end pe-4">Ação</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-box-seam text-gold fs-4 me-3"></i>
                                                <span class="fw-bold text-white">@item.Nome</span>
                                            </div>
                                        </td>
                                        <td class="text-center text-gold-bright fw-bold">R$ @item.Preco.ToString("N2")</td>
                                        <td class="text-end pe-4">
                                            <a href="/Loja/RemoverDoCarrinho/@item.KitId" class="btn btn-outline-danger btn-sm border-0">
                                                <i class="bi bi-trash3"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 delay-2">
                <div class="card card-premium p-4 border-gold bg-gradient-dark">
                    <h5 class="text-white mb-4">Resumo do Pedido</h5>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Subtotal</span>
                        <span class="text-white">R$ @Model.Sum(x => x.Preco).ToString("N2")</span>
                    </div>
                    <hr class="border-secondary">
                    <div class="d-flex justify-content-between mb-4">
                        <span class="fw-bold text-white fs-5">Total</span>
                        <span class="fw-bold text-gold fs-5">R$ @Model.Sum(x => x.Preco).ToString("N2")</span>
                    </div>
                    <a href="/Loja/Checkout" class="btn btn-gold btn-lg w-100 fw-bold py-3 shadow">
                        FINALIZAR PEDIDO <i class="bi bi-check-lg ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card card-premium text-center py-5 delay-1 shadow-lg">
            <div class="card-body">
                <i class="bi bi-cart-x text-muted display-1 opacity-25"></i>
                <h3 class="text-white mt-4 fw-bold">Seu carrinho está vazio</h3>
                <p class="text-muted">Parece que você ainda não escolheu nenhum kit para sua estratégia.</p>
                <a href="/Loja/Index" class="btn btn-gold mt-3 px-5 py-2 fw-bold rounded-pill">
                    EXPLORAR KITS <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
    }
</div>