<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OnClickSystem</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/premium.css" asp-append-version="true" />
</head>
<body class="@(ViewData["Title"]?.ToString() == "Login" ? "body-login" : "")">

    @if (ViewData["Title"]?.ToString() == "Login")
    {
        @RenderBody()
    }
    else
    {
        <nav class="navbar navbar-expand-lg navbar-premium fixed-top">
            <div class="container-fluid">

                <div class="d-flex align-items-center">
                    <button type="button" id="sidebarCollapse" class="btn btn-gold btn-sm me-3 text-dark fw-bold">
                        <i class="fas fa-bars"></i>
                    </button>

                    <a class="navbar-brand text-gold fw-bold" asp-controller="Home" asp-action="Index" style="font-size: 1.5rem; letter-spacing: 1px;">
                        <i class="bi bi-gem me-2"></i>OnClick System
                    </a>
                </div>

                <div class="d-flex align-items-center">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <div class="d-none d-md-block me-4 border-end border-secondary pe-4">
                            <span id="current-date-time" class="text-white-50 small fw-bold text-uppercase" style="letter-spacing: 1px;">
                                Carregando...
                            </span>
                        </div>

                        <div class="user-info-box me-2 border-gold">
                            <span class="text-white small">Olá, <strong class="text-gold">@User.Identity.Name</strong></span>
                        </div>

                        <a asp-controller="Perfil" asp-action="Index" class="btn btn-outline-warning btn-sm rounded-pill me-2" title="Meu Perfil">
                            <i class="fas fa-user-cog"></i>
                        </a>

                        <a asp-controller="Login" asp-action="Sair" class="btn btn-danger btn-sm rounded-pill" title="Sair">
                            <i class="fas fa-sign-out-alt"></i>
                        </a>
                    }
                </div>
            </div>
        </nav>

        <div class="wrapper" id="wrapper">
            <nav id="sidebar">
                <div class="sidebar-header text-center py-4">
                    <small class="text-muted text-uppercase fw-bold" style="letter-spacing: 2px; font-size: 0.7rem;">Menu Principal</small>
                </div>

                <ul class="list-unstyled components">

                    <li>
                        <a asp-controller="Loja" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Loja" ? "active" : "") text-success fw-bold">
                            <i class="fas fa-shopping-cart me-2 text-center" style="width: 25px;"></i> Comprar Kits
                        </a>
                    </li>
                    @if (User.FindFirst("StatusAtivo")?.Value == "True")
                    {
                        <li>
                            <a asp-controller="Home" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Home" ? "active" : "")">
                                <i class="fas fa-tachometer-alt me-2 text-center" style="width: 25px;"></i> Dashboard
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Rede" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Rede" ? "active" : "")">
                                <i class="fas fa-network-wired me-2 text-center" style="width: 25px;"></i> Minha Rede
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Financeiro" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Financeiro" ? "active" : "")">
                                <i class="fas fa-wallet me-2 text-center" style="width: 25px;"></i> Financeiro
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Pedidos" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Pedidos" ? "active" : "")">
                                <i class="fas fa-receipt me-2 text-center" style="width: 25px;"></i> Meus Pedidos
                            </a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <hr class="border-secondary mx-3 opacity-25" />
                            <li class="px-3 text-gold-bright small text-uppercase fw-bold mb-2 mt-3">Administração</li>

                            <li>
                                <a asp-controller="Admin" asp-action="Usuarios" class="@(ViewContext.RouteData.Values["Action"].ToString() == "Usuarios" ? "active" : "")">
                                    <i class="fas fa-users-cog me-2 text-center" style="width: 25px;"></i> Usuários
                                </a>
                            </li>
                            <li>
                                <a asp-controller="Kits" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Kits" ? "active" : "")">
                                    <i class="fas fa-box-open me-2 text-center" style="width: 25px;"></i> Gerenciar Kits
                                </a>
                            </li>
                            <li>
                                <a asp-controller="Admin" asp-action="AprovarSaques" class="@(ViewContext.RouteData.Values["Action"].ToString() == "AprovarSaques" ? "active" : "")">
                                    <i class="fas fa-money-check-alt me-2 text-center" style="width: 25px;"></i> Aprovar Saques
                                </a>
                            </li>
                            <li>
                                <a asp-controller="Admin" asp-action="Relatorios" class="@(ViewContext.RouteData.Values["Action"].ToString() == "Relatorios" ? "active" : "")">
                                    <i class="fas fa-chart-pie me-2 text-warning text-center" style="width: 25px;"></i> Relatórios & Logs
                                </a>
                            </li>
                        }
                    }
                    
                </ul>
            </nav>

            <div id="content">
                <div class="main-content-area p-4">
                    @if (TempData["Sucesso"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert" style="border-left: 5px solid #198754; background-color: #d1e7dd;">
                            <i class="fas fa-check-circle me-2 text-success"></i> @TempData["Sucesso"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Erro"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert" style="border-left: 5px solid #dc3545; background-color: #f8d7da;">
                            <i class="fas fa-exclamation-triangle me-2 text-danger"></i> @TempData["Erro"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @RenderBody()
                </div>

                <footer class="footer-premium py-3 text-center bg-black">
                    <div class="container">
                        <small class="text-muted">
                            &copy; 2026 <strong>OnClickSystem</strong> - Todos os direitos reservados.
                            <span class="mx-2">|</span>
                            <a href="#" class="text-gold text-decoration-none">Suporte</a>
                        </small>
                    </div>
                </footer>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        $(document).ready(function () {
            $('#sidebarCollapse').on('click', function () {
                $('#wrapper').toggleClass('toggled');
            });
        });

        function updateDateTime() {
            const now = new Date();
            const options = { weekday: 'long', year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' };
            try {
                let dateTimeStr = now.toLocaleDateString('pt-BR', options);
                dateTimeStr = dateTimeStr.charAt(0).toUpperCase() + dateTimeStr.slice(1);
                const el = document.getElementById('current-date-time');
                if(el) el.innerHTML = dateTimeStr.replace(".,", ",");
            } catch (e) { console.log(e); }
        }
        setInterval(updateDateTime, 1000);
        updateDateTime();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>