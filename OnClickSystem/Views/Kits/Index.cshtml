@model IEnumerable<OnClickSystem.Domain.Entities.Kit>
@{
    ViewData["Title"] = "Gestão de Kits";
}

<div class="row align-items-center mb-4">
    <div class="col-md-6">
        <h2 class="fw-bold text-gold mb-0"><i class="bi bi-box-seam text-gold"></i> Gestão de Produtos</h2>
    </div>
    <div class="col-md-6 d-flex justify-content-md-end gap-3 mt-3 mt-md-0">
        <div class="search-container w-100">
            <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-gold"><i class="bi bi-search"></i></span>
                <input type="text" id="buscaKits" class="form-control bg-dark text-white border-secondary" placeholder="Buscar kit...">
            </div>
        </div>
        <a href="/Kits/Criar" class="btn btn-gold text-nowrap d-flex align-items-center">
            <i class="bi bi-plus-lg me-2"></i> Novo Kit
        </a>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card card-premium p-0 overflow-hidden shadow-lg">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 align-middle text-center" id="tabelaKits">
                    <thead>
                        <tr class="text-gold border-bottom border-warning">
                            <th class="ps-4 text-start">Nome do Kit</th>
                            <th>Preço</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 text-start fw-bold fs-5">@item.Nome</td>
                                <td class="text-success fw-bold">R$ @item.Preco.ToString("N2")</td>
                                <td>
                                    @if (item.Ativo)
                                    {
                                        <span class="badge bg-success px-3 py-2 rounded-pill">À Venda</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger px-3 py-2 rounded-pill">Arquivado</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a href="/Kits/Editar/@item.ID" class="btn btn-outline-warning btn-sm rounded-pill px-3">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            ativarPesquisa("buscaKits", "tabelaKits");
        });
    </script>
}