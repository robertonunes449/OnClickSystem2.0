@model IEnumerable<OnClickSystem.Domain.Entities.Usuario>
@{
    ViewData["Title"] = "Minha Rede Elite";
    var indiretos = ViewBag.ListaIndiretos as IEnumerable<OnClickSystem.Domain.Entities.Usuario> ?? new List<OnClickSystem.Domain.Entities.Usuario>();
    string nomeUsuario = User.Identity.Name;
    string baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    string linkIndicacao = $"{baseUrl}/Cadastro/Novo?patrocinador={nomeUsuario}";
}

<div class="container-fluid pt-3">

    
    <h1 class="display-5 fw-bold text-gold"> <i class="fas fa-network-wired me-2 text-center"></i>Minha Rede</h1>
    <div class="row mb-4">
        <div class="col-md-6 mb-3">
            <div class="card bg-dark border border-warning shadow h-100">
                <div class="card-body text-center d-flex flex-column justify-content-center py-4">
                    <div class="icon-stat mb-2"><i class="bi bi-people-fill text-gold"></i></div>
                    <h6 class="text-muted text-uppercase small">Diretos (Nível 1)</h6>
                    <h1 class="text-gold display-4 fw-bold m-0">@(ViewBag.TotalDiretos ?? 0)</h1>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-3">
            <div class="card bg-dark border-secondary shadow h-100">
                <div class="card-body text-center d-flex flex-column justify-content-center py-4">
                    <div class="icon-stat mb-2"><i class="bi bi-diagram-3-fill text-secondary"></i></div>
                    <h6 class="text-secondary text-uppercase small">Indiretos (Nível 2)</h6>
                    <h1 class="text-white display-4 fw-bold m-0">@(ViewBag.TotalIndiretos ?? 0)</h1>
                </div>
            </div>
        </div>
    </div>

    <div class="card bg-black border border-gold mb-4 p-4 shadow">
        <div class="row g-3 align-items-end">
            <div class="col-lg-8">
                <h5 class="text-gold fw-bold mb-2"><i class="bi bi-share-fill me-2"></i>Link de Indicação</h5>
                <p class="text-muted small mb-2">Envie este link para cadastrar novos membros na sua rede.</p>

                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-gold"><i class="bi bi-link-45deg"></i></span>
                    <input type="text" class="form-control form-control-premium py-2 text-white" value="@linkIndicacao" id="linkRef" readonly>
                    <button class="btn btn-outline-warning fw-bold" onclick="copiarLink()">
                        <i class="bi bi-clipboard me-1"></i> COPIAR
                    </button>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="d-grid gap-2">
                    <a asp-controller="Cadastro" asp-action="Novo" asp-route-patrocinador="@nomeUsuario" class="btn btn-gold fw-bold text-uppercase py-2 shadow-sm">
                        <i class="bi bi-person-plus-fill me-2"></i> Cadastrar Novo
                    </a>
                    <a href="https://api.whatsapp.com/send?text=Venha fazer parte da minha rede! Cadastre-se: @linkIndicacao"
                       target="_blank" class="btn btn-success fw-bold text-uppercase py-2 shadow-sm">
                        <i class="bi bi-whatsapp me-2"></i> Enviar no Zap
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <ul class="nav nav-pills" id="redeTab" role="tablist">
            <li class="nav-item me-2">
                <button class="nav-link active bg-dark border border-warning text-gold fw-bold px-4" id="nivel1-tab" data-bs-toggle="pill" data-bs-target="#nivel1" type="button">Nível 1</button>
            </li>
            <li class="nav-item">
                <button class="nav-link bg-dark border border-secondary text-white px-4" id="nivel2-tab" data-bs-toggle="pill" data-bs-target="#nivel2" type="button">Nível 2</button>
            </li>
        </ul>

        <div class="search-container">
            <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-search"></i></span>
                <input type="text" id="buscaRede" class="form-control bg-dark border-secondary text-white" placeholder="Buscar afiliado..." style="min-width: 250px;">
            </div>
        </div>
    </div>

    <div class="tab-content" id="redeTabContent">

        <div class="tab-pane fade show active" id="nivel1">
            <div class="card bg-dark shadow border-0">
                <div class="table-responsive">
                    <table class="table table-dark table-hover mb-0 align-middle tabela-rede" id="tabelaNivel1">
                        <thead class="text-secondary small text-uppercase">
                            <tr>
                                <th class="ps-4">Afiliado</th>
                                <th>Indicado Por</th>
                                <th class="text-center">Status</th>
                                <th class="text-center">Data</th>
                                <th class="text-end pe-4">Contato</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var user in Model)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                <div class="rounded-circle bg-dark border border-warning text-gold d-flex justify-content-center align-items-center me-3 fw-bold shadow" style="width: 40px; height: 40px;">
                                                    @(!string.IsNullOrEmpty(user.Nome) ? user.Nome.Substring(0, 1).ToUpper() : "?")
                                                </div>
                                                <div>
                                                    <strong class="text-white d-block">
                                                        @if (User.IsInRole("Admin"))
                                                        {
                                                            <a asp-controller="Admin" asp-action="Detalhes" asp-route-id="@user.ID" class="text-gold text-decoration-none">
                                                                <i class="bi bi-person-gear me-1"></i> @(user.Nome ?? "Sem Nome")
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            @(user.Nome ?? "Sem Nome")
                                                        }
                                                    </strong>
                                                    <small class="text-muted">@(user.Email ?? "-")</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-muted small">
                                            <i class="bi bi-person-up me-1"></i>@(user.Patrocinador?.Nome ?? "Direto da Empresa")
                                        </td>
                                        <td class="text-center">
                                            @if (user.Ativo)
                                            {
                                                <span class="badge bg-success bg-opacity-75"><i class="bi bi-check-circle me-1"></i> ATIVO</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary"><i class="bi bi-hourglass-split me-1"></i> PENDENTE</span>
                                            }
                                        </td>
                                        <td class="text-center text-muted small">
                                            @user.DataCadastro.ToString("dd/MM/yyyy")
                                        </td>
                                        <td class="text-end pe-4">
                                            <a href="mailto:@user.Email" class="btn btn-sm btn-outline-light rounded-circle"><i class="bi bi-envelope"></i></a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="5" class="text-center py-5 text-muted"><i class="bi bi-emoji-frown mb-2 d-block fs-3"></i> Ninguém no Nível 1 ainda.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="nivel2">
            <div class="card bg-dark shadow border-0">
                <div class="table-responsive">
                    <table class="table table-dark table-hover mb-0 align-middle tabela-rede" id="tabelaNivel2">
                        <thead class="text-secondary small text-uppercase">
                            <tr>
                                <th class="ps-4">Afiliado (Neto)</th>
                                <th>Indicado Por</th>
                                <th class="text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (indiretos.Any())
                            {
                                @foreach (var user in indiretos)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                <div class="rounded-circle bg-secondary text-white d-flex justify-content-center align-items-center me-3 fw-bold" style="width: 40px; height: 40px;">
                                                    @(!string.IsNullOrEmpty(user.Nome) ? user.Nome.Substring(0, 1).ToUpper() : "?")
                                                </div>
                                                <div class="text-white">
                                                    @if (User.IsInRole("Admin"))
                                                    {
                                                        <a asp-controller="Admin" asp-action="Detalhes" asp-route-id="@user.ID" class="text-gold text-decoration-none">
                                                            @(user.Nome ?? "Sem Nome")
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        @(user.Nome ?? "Sem Nome")
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-gold small">
                                            <i class="bi bi-arrow-return-right me-1"></i>
                                            @(user.Patrocinador?.Nome ?? "Indisponível")
                                        </td>
                                        <td class="text-center">
                                            @if (user.Ativo)
                                            {
                                                <span class="badge bg-success bg-opacity-75">ATIVO</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">PENDENTE</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="3" class="text-center py-5 text-muted">Sua rede ainda não cresceu para o Nível 2.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copiarLink() {
            var copyText = document.getElementById("linkRef");
            copyText.select();
            navigator.clipboard.writeText(copyText.value);
            alert("Link copiado com sucesso!");
        }

        document.addEventListener("DOMContentLoaded", function() {
            // Liga a pesquisa para a tabela do Nível 1
            ativarPesquisa("buscaRede", "tabelaNivel1");

            // Liga a mesma pesquisa para a tabela do Nível 2
            ativarPesquisa("buscaRede", "tabelaNivel2");
        });
    </script>
}