@{
    ViewData["Title"] = "Minha Rede";
}

<div class="fade-in-up">
    <div class="mb-4">
        <h2 class="fw-bold text-gold"><i class="bi bi-diagram-3 me-2"></i> Expansão de Rede</h2>
        <p class="text-muted">Visualize e gerencie seus afiliados diretos e indiretos.</p>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4 delay-1">
            <div class="card card-stat p-3 border-start border-info border-4">
                <small class="text-muted text-uppercase fw-bold">Diretos</small>
                <h2 class="text-white mb-0">@(ViewBag.QuantidadeDiretos ?? 0)</h2>
            </div>
        </div>
        <div class="col-md-4 delay-2">
            <div class="card card-stat p-3 border-start border-warning border-4">
                <small class="text-muted text-uppercase fw-bold">Rede Total</small>
                <h2 class="text-white mb-0">@(ViewBag.QuantidadeRedeTotal ?? 0)</h2>
            </div>
        </div>
        <div class="col-md-4 delay-3">
            <div class="card card-stat p-3 border-start border-success border-4">
                <small class="text-muted text-uppercase fw-bold">Ativos</small>
                <h2 class="text-success mb-0">@(ViewBag.QuantidadeAtivos ?? 0)</h2>
            </div>
        </div>
    </div>

    <div class="card card-premium p-0 delay-4">
        <div class="card-header bg-dark border-secondary py-3">
            <h5 class="mb-0 text-white">Meus Indicados</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle">
                <thead class="text-muted small">
                    <tr>
                        <th class="ps-4">AFILIADO</th>
                        <th class="text-center">NÍVEL</th>
                        <th class="text-center">STATUS</th>
                        <th class="text-end pe-4">DATA ADESÃO</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.MinhaRede != null)
                    {
                        foreach (var item in ViewBag.MinhaRede)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle me-3">@item.Nome.Substring(0, 1)</div>
                                        <div>
                                            <div class="text-white fw-bold">@item.Nome</div>
                                            <div class="small text-muted">@item.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center"><span class="badge bg-dark border border-secondary text-secondary">Lvl @item.Nivel</span></td>
                                <td class="text-center">
                                    @if (item.Ativo)
                                    {
                                        <span class="text-success"><i class="bi bi-patch-check-fill me-1"></i> Ativo</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger"><i class="bi bi-clock-history me-1"></i> Pendente</span>
                                    }
                                </td>
                                <td class="text-end pe-4 text-muted">@item.DataCadastro.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .avatar-circle {
        width: 35px;
        height: 35px;
        background: #d4af37;
        color: black;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
    }
</style>