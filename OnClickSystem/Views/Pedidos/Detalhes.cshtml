@model OnClickSystem.Domain.Entities.Pedido
@{
    ViewData["Title"] = "Recibo #" + Model.ID;
    var codigoTransacao = "TX-" + Model.DataPedido.ToString("yyyyMMdd") + "-" + Model.ID.ToString("D4");
}

<div class="container d-flex justify-content-center py-4 fade-in-up">
    <div style="max-width: 600px; width: 100%;">
        
        <a href="/Pedidos/Index" class="btn btn-link text-muted p-0 mb-4 text-decoration-none delay-1">
            <i class="bi bi-arrow-left"></i> Voltar para a lista
        </a>

        <div class="card card-premium shadow-lg border-gold delay-2 overflow-hidden">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-5">
                    <div class="mb-3">
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                    </div>
                    <h3 class="fw-bold text-white mb-1">Pagamento Confirmado</h3>
                    <p class="text-muted small">@Model.DataPedido.ToString("dd/MM/yyyy HH:mm:ss")</p>
                </div>

                <div class="row g-3 mb-5 bg-dark bg-opacity-50 p-3 rounded-3 border border-secondary border-opacity-25">
                    <div class="col-6">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">Cliente</small>
                        <span class="text-white fw-bold d-block">@Model.Usuario.Nome</span>
                        <span class="text-muted small">@Model.Usuario.Email</span>
                    </div>
                    <div class="col-6 text-end">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">ID Transação</small>
                        <span class="text-white fw-bold d-block font-monospace small">@codigoTransacao</span>
                    </div>
                </div>

                <div class="mb-5">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex align-items-center">
                            <div class="bg-gold bg-opacity-10 p-2 rounded-3 me-3">
                                <i class="bi bi-gem text-gold fs-4"></i>
                            </div>
                            <div>
                                <h6 class="text-white mb-0">@Model.Kit.Nome</h6>
                                <small class="text-muted">Licença de Uso e Ativação</small>
                            </div>
                        </div>
                        <span class="text-white fw-bold">R$ @Model.Valor.ToString("N2")</span>
                    </div>
                </div>

                <hr class="border-secondary border-opacity-50 my-4">

                <div class="d-flex justify-content-between align-items-center mb-5">
                    <span class="text-muted fs-5">Valor Total</span>
                    <span class="text-gold fs-3 fw-bold">R$ @Model.Valor.ToString("N2")</span>
                </div>

                <div class="text-center mt-5 pt-4 border-top border-secondary border-opacity-25">
                    <p class="text-muted small mb-3">Este é um comprovante digital de ativação de conta OnClick System.</p>
                    <div class="d-grid gap-2">
                        <button onclick="window.print()" class="btn btn-gold py-2 fw-bold shadow">
                            <i class="bi bi-printer-fill me-2"></i> IMPRIMIR COMPROVANTE
                        </button>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="text-center mt-4 text-muted small">
            OnClick System Inc. • CNPJ 00.000.000/0001-00
        </div>
    </div>
</div>

<style>
    /* Estilo para garantir que o recibo fique bonito na impressão */
    @@media print {
        .btn, .text-muted, .bi-arrow-left { display: none !important; }
        .card-premium { background: white !important; color: black !important; border: 1px solid #ccc !important; }
        .text-white, .text-gold { color: black !important; }
        body { background: white !important; }
    }
</style>