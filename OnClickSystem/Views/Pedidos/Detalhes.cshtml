@model OnClickSystem.Domain.Entities.Pedido
@{
    ViewData["Title"] = "Recibo #" + Model.ID;
    var codigoTransacao = "TX-" + Model.DataPedido.ToString("yyyyMMdd") + "-" + Model.ID.ToString("D4");
}

<div class="row justify-content-center">
    <div class="col-md-8">

        <a href="/Pedidos/Index" class="btn btn-outline-secondary mb-3 btn-sm">
            <i class="bi bi-arrow-left"></i> Voltar
        </a>

        <div class="card bg-white text-dark shadow-lg" style="border-top: 5px solid #d4af37;">
            <div class="card-body p-5">

                <div class="d-flex justify-content-between align-items-center mb-5">
                    <div>
                        <h3 class="fw-bold text-black mb-0"><i class="bi bi-gem text-warning"></i> OnClick</h3>
                        <small class="text-muted">Comprovante de Pagamento</small>
                    </div>
                    <div class="text-end">
                        <div class="text-uppercase text-muted small">Status</div>
                        <span class="badge bg-success fs-6">PAGAMENTO APROVADO</span>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-6">
                        <small class="text-muted text-uppercase">Cliente</small>
                        <div class="fw-bold">@Model.Usuario.Nome</div>
                        <div class="small text-muted">@Model.Usuario.Email</div>
                    </div>
                    <div class="col-6 text-end">
                        <small class="text-muted text-uppercase">Transação ID</small>
                        <div class="fw-bold font-monospace">@codigoTransacao</div>
                        <div class="small text-muted">@Model.DataPedido.ToString("dd/MM/yyyy HH:mm:ss")</div>
                    </div>
                </div>

                <hr class="my-4">

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold">1x @Model.Kit.Nome</span>
                    <span>R$ @Model.Valor.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between align-items-center text-muted small">
                    <span>Ativação de conta e acesso ao painel</span>
                    <span>-</span>
                </div>

                <hr class="my-4">

                <div class="d-flex justify-content-between align-items-center">
                    <span class="fs-5">Total Pago</span>
                    <span class="fs-4 fw-bold text-success">R$ @Model.Valor.ToString("N2")</span>
                </div>

                <div class="mt-5 pt-4 text-center border-top">
                    <p class="text-muted small mb-1">Obrigado pela sua compra!</p>
                    <small class="text-muted" style="font-size: 0.7rem;">OnClick System Inc. - CNPJ 00.000.000/0001-00</small>
                </div>

            </div>
        </div>

        <div class="text-center mt-4">
            <button onclick="window.print()" class="btn btn-gold shadow">
                <i class="bi bi-printer-fill"></i> Imprimir Comprovante
            </button>
        </div>

    </div>
</div>