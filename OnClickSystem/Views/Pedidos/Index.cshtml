@model IEnumerable<OnClickSystem.Domain.Entities.Pedido>
@{
    ViewData["Title"] = "Meus Pedidos";
}

<div class="fade-in-up">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-gold mb-1"><i class="bi bi-bag-check-fill me-2"></i> Meus Pedidos</h2>
            <p class="text-muted">Acompanhe o histórico e status de suas ativações.</p>
        </div>
    </div>

    <div class="card card-premium p-0 delay-1 shadow-lg">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle">
                <thead class="text-muted small text-uppercase bg-black bg-opacity-50">
                    <tr>
                        <th class="ps-4 py-3">ID Pedido</th>
                        <th>Data</th>
                        <th class="text-center">Status</th>
                        <th class="text-center">Total</th>
                        <th class="text-end pe-4">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">
                                <span class="text-gold">#</span>@p.ID.ToString().PadLeft(5, '0')
                            </td>
                            <td class="text-white-50">@p.DataPedido.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-center">
                                @if (p.Status == "Aprovado")
                                {
                                    <span class="badge-status success">
                                        <i class="bi bi-check-circle-fill me-1"></i> APROVADO
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-status warning">
                                        <i class="bi bi-clock-history me-1"></i> PENDENTE
                                    </span>
                                }
                            </td>
                            <td class="text-center fw-bold text-white">R$ @p.Valor.ToString("N2")</td>
                            <td class="text-end pe-4">
                                <a href="/Pedidos/Detalhes/@p.ID" class="btn btn-outline-gold btn-sm rounded-pill px-3">
                                    Ver Detalhes
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    /* Estilo para as Badges Modernas */
    .badge-status {
        padding: 6px 14px;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        border: 1px solid transparent;
    }
    .badge-status.success {
        background: rgba(40, 167, 69, 0.1);
        color: #28a745;
        border-color: rgba(40, 167, 69, 0.2);
    }
    .badge-status.warning {
        background: rgba(255, 193, 7, 0.1);
        color: #ffc107;
        border-color: rgba(255, 193, 7, 0.2);
    }
    .btn-outline-gold {
        color: #d4af37;
        border-color: #d4af37;
    }
    .btn-outline-gold:hover {
        background-color: #d4af37;
        color: #000;
    }
</style>