@model IEnumerable<OnClickSystem.Domain.Entities.Pedido>
@{
    ViewData["Title"] = "Meus Pedidos";
}

<div class="row align-items-center mb-4">
    <div class="col-md-6">
        <h2 class="fw-bold text-gold mb-0"><i class="bi bi-receipt text-gold"></i> Histórico de Compras</h2>
    </div>
    <div class="col-md-6">
        <div class="input-group">
            <span class="input-group-text bg-dark border-secondary text-gold"><i class="bi bi-search"></i></span>
            <input type="text" id="buscaPedidos" class="form-control bg-dark text-white border-secondary" placeholder="Filtrar pedidos...">
        </div>
    </div>
</div>

<div class="card card-premium p-0 overflow-hidden shadow-lg">
    <div class="table-responsive">
        <table class="table table-dark table-hover mb-0 align-middle" id="tabelaPedidos">
            <thead>
                <tr class="text-gold border-bottom border-warning text-center">
                    <th class="ps-4 text-start">Produto / Kit</th>
                    <th>Data</th>
                    <th>Valor</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Recibo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="text-center">
                        <td class="ps-4 text-start fw-bold text-white">
                            <i class="bi bi-box-seam text-secondary me-2"></i> @item.Kit.Nome
                        </td>
                        <td class="text-muted">@item.DataPedido.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-success fw-bold">R$ @item.Valor.ToString("N2")</td>
                        <td>
                            <span class="badge bg-success bg-opacity-75"><i class="bi bi-check2-all"></i> PAGO</span>
                        </td>
                        <td class="text-end pe-4">
                            <a href="/Pedidos/Detalhes/@item.ID" class="btn btn-sm btn-gold text-dark fw-bold">Ver Recibo</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">Você ainda não fez nenhuma compra.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            ativarPesquisa("buscaPedidos", "tabelaPedidos");
        });
    </script>
}